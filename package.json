{
  "name": "statsig-browser-extension",
  "displayName": "Statsig Features and Experimentation",
  "version": "1.17.0",
  "description": "A browser extension for the feature management and experimentation platform Statsig.",
  "author": "(Aaron van den Berg <a.vdberg98@gmail.com>)",
  "homepage": "https://aaronvandenberg.nl/",
  "scripts": {
    "dev": "wxt",
    "lint": "biome lint .",
    "build": "wxt zip",
    "knip": "knip",
    "typecheck": "wxt prepare && tsc --noEmit",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@heroui/react": "^2.8.10",
    "@microlink/react-json-view": "^1.31.51",
    "@uidotdev/usehooks": "^2.4.1",
    "axios": "^1.21.1",
    "framer-motion": "^14.14.0",
    "fuse.js": "^7.5.0",
    "immer": "^11.2.10",
    "motion": "^14.14.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-icons": "^5.7.0",
    "react-modal-sheet": "^5.7.0",
    "react-timeago": "^8.3.0",
    "react-tooltip": "^6.0.12",
    "swr": "^2.5.1",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@heroui/theme": "^2.4.26",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/chrome": "0.3.7",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wxt-dev/module-react": "^1.2.2",
    "knip": "^6.45.1",
    "tailwindcss": "^4.3.5",
    "typescript": "7.0.2",
    "vite": "^8.3.8",
    "wxt": "^0.21.5"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "packageManager": "npm@11.19.1",
  "allowScripts": {
    "@heroui/shared-utils@2.1.12": true,
    "fsevents": false
  }
}
